# ==============================================================================
# BACKEND REST API (Node.js + Express + Socket.IO + Supabase)
# ==============================================================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
ENABLE_SWAGGER=true

# ==============================================================================
# SUPABASE CONFIGURAÇÃO (Cloud / BaaS)
# ==============================================================================
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_publica_do_supabase
# ATENÇÃO: A Service Role Key ignora o RLS — NUNCA exponha no Frontend!
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_secreta_do_supabase
