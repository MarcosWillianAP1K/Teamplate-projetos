# ==============================================================================
# BACKEND REST API (Node.js + Express + Socket.IO)
# ==============================================================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
ENABLE_SWAGGER=true

# ==============================================================================
# BANCO DE DADOS POSTGRESQL (Docker / VPS)
# ==============================================================================
# Host local é 'localhost'; entre containers docker compose é 'postgres'.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=template_db
DB_SSL=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/template_db

# ==============================================================================
# AUTENTICAÇÃO JWT PRÓPRIA
# ==============================================================================
JWT_SECRET=chave_secreta_jwt_desenvolvimento_trocar_na_vps
JWT_EXPIRES_IN=7d
