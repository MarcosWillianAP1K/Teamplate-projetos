# ==============================================================================
# CONFIGURAÇÃO ISOLADA DO BANCO DE DADOS POSTGRESQL (Pasta Database/)
# Usado quando você sobe o banco no Docker (Modo SemSupabase / VPS / Local)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=template_db
POSTGRES_PORT=5432

# Porta do Painel Visual Web (Adminer) para você ver as tabelas no navegador
# Acesse http://localhost:8080 após subir o banco!
ADMINER_PORT=8080
